    </div>
    <script>
    function calc(){
      var g=parseFloat(document.getElementById('exp').value);
      var box=document.getElementById('result');
      if(isNaN(g)||g<0||g>4){box.style.display='block';box.textContent='กรุณากรอกเกรดที่คาดหวังระหว่าง 0 ถึง 4';return;}
      var gpax=%s, earned=%s, tc=7.5, target=%s;
      var n=(gpax*earned+g*tc)/(earned+tc);
      var m='ถ้าได้เกรด '+g.toFixed(2)+' เทอมนี้ GPAX สะสมจะอยู่ที่ '+n.toFixed(3)+(n>=target?' (ถึงเป้าหมายแล้ว 🎯)':' (ยังไม่ถึงเป้าหมาย)');
      box.style.display='block';box.textContent=m;
    }</script>""" % (passed, trs, p["gpax"], p["credits_earned"], p["target_gpax"])
    return render(content, "grades", "ผลการเรียน", p=p)

