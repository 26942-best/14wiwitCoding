def badge(t):
    m = {"ด่วนมาก": "badge-danger", "กำลังทำ": "badge-warn", "รอดำเนินการ": "badge-muted",
         "สอบ": "badge-danger", "กำหนดส่ง": "badge-warn", "กิจกรรม": "badge-info", "ประกาศ": "badge-muted"}
    return '<span class="badge %s">%s</span>' % (m.get(t, "badge-muted"), t)

