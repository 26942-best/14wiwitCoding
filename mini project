      <thead><tr><th>ภาคเรียน</th><th>รหัสวิชา</th><th>ชื่อวิชา</th><th>กลุ่มวิชา</th><th>หน่วยกิต</th><th>เกรด</th><th>ผลการประเมิน</th></tr></thead>
      <tbody>%s</tbody></table></div></div>
    <div class="card"><h3>เครื่องคำนวณเกรดล่วงหน้า</h3>
      <p style="font-size:13px;color:#6b7280;margin-bottom:16px">จำลองเกรดเทอมนี้เพื่อดูผลกระทบต่อ GPAX รวม</p>
      <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap">
        <div style="flex:1;min-width:200px"><label for="exp">เกรดเฉลี่ยเทอมนี้ที่คาดหวัง</label>
